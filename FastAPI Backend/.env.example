# ============================ Application ============================
APP_NAME=AI_Crypto_Signal
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ============================ Database ==============================
# For docker-compose these also feed the db service (POSTGRES_*).
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/crypto_signals
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=crypto_signals

# ============================ Redis =================================
REDIS_URL=redis://redis:6379/0

# ============================ Binance ===============================
# Public market data needs no keys. Keys enable authenticated endpoints.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ============================ Security ==============================
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Leave API_KEY empty to keep the API open (desktop client works out of the
# box). Set a strong value to require the `X-API-Key` header on every request.
API_KEY=
# Comma-separated CORS origins, or * for all.
CORS_ORIGINS=*

# ==================== Strategy (multi-timeframe ICT) =================
HTF_TIMEFRAMES=4h,1h
LTF_TIMEFRAME=15m
STREAM_TIMEFRAMES=5m,15m,1h,4h
MIN_CONFIDENCE=65
MIN_RISK_REWARD=1.5
# Only generate signals inside ICT kill zones (London/NY) when true.
ENFORCE_KILLZONES=false
# Optional: comma-separated symbol override (defaults to the built-in universe).
SCAN_SYMBOLS=

# ======================= Signal lifecycle ==========================
TRACKER_ENABLED=true
TRACKER_INTERVAL_SECONDS=15

# ======================= Process topology ==========================
# true  = one process runs API + scanner + tracker (simplest).
# false = API only (scale it); run the engine via `python -m app.worker`.
RUN_SCANNER=true
# Create tables on startup. Set false in production and use Alembic migrations.
AUTO_CREATE_TABLES=true
