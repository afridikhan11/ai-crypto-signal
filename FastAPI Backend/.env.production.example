# Production environment template.
#
# Copy this to .env.production and fill in real values BEFORE deploying.
# Never commit the filled-in .env.production file - it holds secrets.
#
#   cp .env.production.example .env.production
#   python scripts/generate_secret_key.py    # paste the output below as SECRET_KEY
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Application
APP_NAME=AI_Crypto_Signal
# false in production: disables /docs (Swagger UI) and verbose debug logging.
# Only ever set true temporarily on a machine you control, then flip back.
DEBUG=false
LOG_LEVEL=INFO

# Database - use a strong, unique password (not the "user/password" dev default).
# POSTGRES_USER/POSTGRES_PASSWORD below must match what's in DATABASE_URL.
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_to_a_strong_random_password
DATABASE_URL=postgresql+asyncpg://change_me:change_me_to_a_strong_random_password@db:5432/crypto_signals

# Redis - internal to the docker network in production (see docker-compose.prod.yml,
# which does not publish 5432/6379 to the host).
REDIS_URL=redis://redis:6379/0

# Binance (only needed if you plan to link a real account - safe to leave blank,
# the app works signal-only without it)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Security - REQUIRED. Generate with: python scripts/generate_secret_key.py
# This encrypts saved Binance credentials (see app/security/api_key_cipher.py)
# AND signs JWT auth tokens (see app/core/security.py). Changing this after
# credentials are saved makes them undecryptable - you'll need to re-enter
# them in Settings. Never reuse the dev default.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Authentication - recommended true for any deployment reachable outside
# your own machine (see app/core/security.py for what this does and does
# NOT cover - single admin account, not multi-tenant). Off by default in
# dev (.env) so nothing there needs to change.
REQUIRE_AUTH=true
ADMIN_USERNAME=admin
# Generate with: python scripts/generate_password_hash.py
ADMIN_PASSWORD_HASH=
