# Application
APP_NAME=AI_Crypto_Signal
DEBUG=false
LOG_LEVEL=INFO

# Database – Docker service name "db"
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/crypto_signals

# Redis – Docker service name "redis"
REDIS_URL=redis://redis:6379/0

# Binance (public endpoints – leave empty for now)
BINANCE_API_KEY=your_api_key
BINANCE_SECRET_KEY=your_secret_key

# Security
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30