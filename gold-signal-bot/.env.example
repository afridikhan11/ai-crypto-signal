# Copy to .env and fill in. .env is gitignored - never commit real values.

# ---------------------------------------------------------------------------
# PRICE FEED - OANDA v20
# A free practice account at oanda.com gives a token that works here.
# "practice" and "live" issue DIFFERENT tokens; a practice token on the live
# host returns 401.
# ---------------------------------------------------------------------------
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice

# ---------------------------------------------------------------------------
# DELIVERY - console | whatsapp | telegram
# Start on console (no account needed), move to whatsapp once it works.
# ---------------------------------------------------------------------------
SIGNAL_CHANNEL=console

# WhatsApp via Twilio. The sandbox number works immediately; a dedicated
# number needs business verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+92XXXXXXXXXX

# Telegram - free, instant, no approval. Message @BotFather for the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# THE SETUP - defaults are the owner's own numbers
# 1 pip = $0.10 on gold, entry in the engulfed candle's last 30 pips,
# stop 90 pips beyond its extreme, take-profit at 1:2.
# ---------------------------------------------------------------------------
INSTRUMENT=XAU_USD
GRANULARITY=M30
PIP_SIZE=0.10
ENTRY_PIPS=30
STOP_PIPS=90
RISK_REWARD=2.0
MAX_BARS_SINCE_BREAK=3
LOOKBACK=40

# ---------------------------------------------------------------------------
# RUNNING
# ---------------------------------------------------------------------------
POLL_SECONDS=60
IDLE_POLL_SECONDS=900
DB_PATH=signals.db
