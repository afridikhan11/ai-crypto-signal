<Window x:Class="AI_Crypto_Signal_Pro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="AI Crypto Signal Pro"
        Height="900"
        Width="1400"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Custom window chrome + drop shadow -->
        <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                CornerRadius="16"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.6"
                                  Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <!-- Title bar -->
                    <RowDefinition Height="*" />
                    <!-- Main area -->
                    <RowDefinition Height="28" />
                    <!-- Status bar -->
                </Grid.RowDefinitions>

                <!-- ========== TITLE BAR ========== -->
                <Grid Grid.Row="0"
                      Background="{DynamicResource SecondaryBackgroundBrush}"
                      MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="AlphaA"
                                                 Width="16"
                                                 Height="16"
                                                 Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="AI Crypto Signal Pro"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Width="36"
                                Height="28"
                                ToolTip="Minimize"
                                Click="MinimizeButton_Click"
                                Content="{materialDesign:PackIcon Kind=WindowMinimize}" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Width="36"
                                Height="28"
                                ToolTip="Maximize"
                                Click="MaximizeButton_Click"
                                Content="{materialDesign:PackIcon Kind=WindowMaximize}" />
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Width="36"
                                Height="28"
                                ToolTip="Close"
                                Click="CloseButton_Click"
                                Content="{materialDesign:PackIcon Kind=WindowClose}" />
                    </StackPanel>
                </Grid>

                <!-- ========== MAIN CONTENT ========== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="281*" />
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                            Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ListBox x:Name="NavigationListBox"
                                     Grid.Row="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0,16,0,0"
                                     SelectedIndex="0">
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="HomeOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Dashboard" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ChartLineVariant" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Crypto Signals" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Diamond" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Gold Signal" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ChartAreaspline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Statistics" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="History" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldAccountOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Account" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FlashOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Auto Trading" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MagnifyScan" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Token Scanner" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="RobotOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="AI Assistant" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Portfolio Intelligence" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ChartBoxOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="AI Performance" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Height="44" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="Settings" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <Border Grid.Row="1"
                                    Height="44"
                                    Background="{DynamicResource ElevatedBackgroundBrush}"
                                    Padding="20,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="LanConnect" Width="14" Height="14"
                                                             Foreground="{Binding BinanceStatusColor}" />
                                    <TextBlock Text="{Binding BinanceStatusText}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Dashboard Content -->
                    <ContentControl x:Name="MainContent"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Background="{DynamicResource PrimaryBackgroundBrush}" />
                </Grid>

                <!-- ========== STATUS BAR ========== -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        Padding="12,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                                     Foreground="{Binding BackendStatusColor}" />
                            <TextBlock Text="{Binding BackendStatusText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="|"
                                       Foreground="#30363D"
                                       Margin="12,0" />
                            <materialDesign:PackIcon Kind="DatabaseOutline" Width="12" Height="12"
                                                     Foreground="{Binding DbStatusColor}" />
                            <TextBlock Text="{Binding DbStatusText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="|"
                                       Foreground="#30363D"
                                       Margin="12,0" />
                            <materialDesign:PackIcon Kind="Web" Width="12" Height="12"
                                                     Foreground="{Binding WebSocketStatusColor}" />
                            <TextBlock Text="{Binding WebSocketStatusText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Text="v1.0.0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>


