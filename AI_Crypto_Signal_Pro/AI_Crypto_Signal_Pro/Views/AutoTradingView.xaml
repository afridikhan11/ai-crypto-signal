<!-- ========== Views/AutoTradingView.xaml ==========
     The ONLY screen in this app with a control that can place a real
     order (the per-signal Execute button). Balance/positions are the same
     read-only GET /account/snapshot data the Account tab shows - see
     AutoTradingViewModel's header comment. -->
<UserControl x:Class="AI_Crypto_Signal_Pro.Views.AutoTradingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
             TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Auto Trading" FontSize="22" FontWeight="SemiBold" />
                    <Border CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"
                            Background="{Binding Environment, Converter={StaticResource EnvironmentToBrushConverter}}">
                        <TextBlock Text="{Binding Environment}" FontSize="11" FontWeight="Bold"
                                   Foreground="Black" />
                    </Border>
                </StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0">
                    <Run Text="Executing a signal here places a REAL order on Binance in the environment shown above." />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                           Foreground="#FF5252" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1" Content="Refresh"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- ===== Auto Trading Control Panel (2026-07-30) =====
             Pure control/visualization surface: every button below calls
             exactly one real backend endpoint in
             app/api/v1/endpoints/trading_control.py - no trading decision,
             no bulk-action loop, and no ICT/AI/Scanner logic lives in this
             app. See AutoTradingViewModel's class-level doc comment. -->
        <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                Padding="20" Margin="0,0,0,16" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <materialDesign:PackIcon Kind="ShieldAccountOutline" Width="18" Height="18"
                                             Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Auto Trading Control Panel" FontSize="15" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ControlStatusMessage}" FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}" Margin="16,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ControlErrorMessage}" FontSize="12"
                               Foreground="#FF5252" Margin="16,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Status chips -->
                <UniformGrid Columns="6" Margin="0,0,0,16">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Trading Status" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="9" Height="9" Fill="{Binding TradingStatus.TradingStatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TradingStatus.TradingStatusLabel}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Binance Status" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="9" Height="9" Fill="{Binding TradingStatus.BinanceStatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TradingStatus.BinanceStatusLabel}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="AI Status" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="9" Height="9" Fill="{Binding TradingStatus.AiStatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TradingStatus.AiStatusLabel}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       ToolTip="{Binding TradingStatus.AiStatusMessage}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Scanner Status" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="9" Height="9" Fill="{Binding TradingStatus.ScannerStatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TradingStatus.ScannerStatusLabel}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Risk Engine Status" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="9" Height="9" Fill="{Binding TradingStatus.RiskEngineStatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TradingStatus.RiskEngineStatusLabel}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Auto Trading" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="9" Height="9" Fill="{Binding TradingStatus.AutoTradingColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TradingStatus.AutoTradingLabel}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </UniformGrid>

                <!-- Metric cards -->
                <UniformGrid Columns="6" Margin="0,0,0,16">
                    <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Daily PnL" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TradingStatus.DailyPnlDisplay}" FontSize="16" FontWeight="Bold"
                                       Foreground="{Binding TradingStatus.DailyPnlColor}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Win Rate" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TradingStatus.WinRateDisplay}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Active Trades" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TradingStatus.ActiveTrades}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Pending Signals" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TradingStatus.PendingSignals}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- ICT Pending Limit Entry (2026-07-30): entries ARMED with a real
                         LIMIT order resting on Binance, waiting for price to reach the
                         ICT zone. Not yet a position - deliberately separate from both
                         Pending Signals and Active Trades. -->
                    <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Armed ICT Entries" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TradingStatus.PendingEntries}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding TradingStatus.PendingEntriesDisplay}" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Entry Model" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TradingStatus.EntryModeLabel}" FontSize="16" FontWeight="Bold"
                                       Foreground="{Binding TradingStatus.EntryModeColor}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Executed Signals" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TradingStatus.ExecutedSignals}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Portfolio Open Risk" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding TradingStatus.PortfolioOpenRiskDisplay}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Risk Limits + Session readout -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Risk Limits (configured in RiskEngine)" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="5">
                                <StackPanel>
                                    <TextBlock Text="Max Risk / Trade" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding TradingStatus.RiskLimits.MaxRiskPercentPerTrade, StringFormat={}{0}%}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Max Open Risk" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding TradingStatus.RiskLimits.MaxOpenRiskPercent, StringFormat={}{0}%}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Max Daily Loss" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding TradingStatus.RiskLimits.MaxDailyLossPercent, StringFormat={}{0}%}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Max Exposure" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding TradingStatus.RiskLimits.MaxExposurePercent, StringFormat={}{0}%}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Max Drawdown" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding TradingStatus.RiskLimits.MaxDrawdownPercent, StringFormat={}{0}%}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Padding="14">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="Session (" /><Run Text="{Binding TradingStatus.Session.ReferenceSymbol, Mode=OneWay}" /><Run Text=", read-only)" />
                            </TextBlock>
                            <TextBlock Text="{Binding TradingStatus.Session.Display}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Asset / Timeframe Selection - real filters on GET /signals -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Asset" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                        <ComboBox Width="140" ItemsSource="{Binding AssetFilterOptions}"
                                  SelectedItem="{Binding SelectedAssetFilter}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Timeframe" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                        <ComboBox Width="140" ItemsSource="{Binding TimeframeFilterOptions}"
                                  SelectedItem="{Binding SelectedTimeframeFilter}" />
                    </StackPanel>
                </StackPanel>

                <!-- Controls -->
                <WrapPanel>
                    <Button Margin="0,0,10,10" Padding="16,0" Height="38"
                            Background="{Binding TradingStatus.AutoTradingColor}" BorderThickness="0" Foreground="White"
                            Cursor="Hand" IsEnabled="{Binding IsControlActionRunning, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding ToggleAutoTradingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PowerPlug" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="Auto Trading: " /><Run Text="{Binding TradingStatus.AutoTradingLabel, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,10,10" Padding="16,0" Height="38" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsControlActionRunning, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding StartEngineCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" Foreground="White" />
                            <TextBlock Text="Start" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,10,10" Padding="16,0" Height="38" Background="#FFC107" BorderThickness="0" Cursor="Hand"
                            IsEnabled="{Binding IsControlActionRunning, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding PauseEngineCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pause" Width="16" Height="16" VerticalAlignment="Center" Foreground="Black" />
                            <TextBlock Text="Pause" Margin="8,0,0,0" Foreground="Black" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,10,10" Padding="16,0" Height="38" Background="#616161" BorderThickness="0" Cursor="Hand"
                            IsEnabled="{Binding IsControlActionRunning, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding StopEngineCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" VerticalAlignment="Center" Foreground="White" />
                            <TextBlock Text="Stop" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,10,10" Padding="16,0" Height="38" Background="#29B6F6" BorderThickness="0" Cursor="Hand"
                            IsEnabled="{Binding IsControlActionRunning, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding ResumeEngineCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="White" />
                            <TextBlock Text="Resume" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,10,10" Padding="16,0" Height="38" Background="#FF5252" BorderThickness="0" Cursor="Hand"
                            IsEnabled="{Binding IsControlActionRunning, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding CloseAllPositionsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="White" />
                            <TextBlock Text="Close All Positions" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,10,10" Padding="16,0" Height="38" Background="#FF5252" BorderThickness="0" Cursor="Hand"
                            IsEnabled="{Binding IsControlActionRunning, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding CancelAllOrdersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MinusCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="White" />
                            <TextBlock Text="Cancel Pending Orders" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Margin="0,0,10,10" Padding="16,0" Height="38" Background="#B71C1C" BorderThickness="0" Cursor="Hand"
                            IsEnabled="{Binding IsControlActionRunning, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding KillSwitchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="White" />
                            <TextBlock Text="EMERGENCY KILL SWITCH" Margin="8,0,0,0" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===== Balance cards (Binance-style) ===== -->
                <UniformGrid Columns="4" Height="100" Margin="0,0,0,16">
                    <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                            Margin="0,0,10,0" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Wallet Balance" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Futures.WalletBalance, StringFormat='{}{0:N2} USDT'}"
                                       FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                            Margin="0,0,10,0" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Available Balance" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Futures.AvailableBalance, StringFormat='{}{0:N2} USDT'}"
                                       FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                            Margin="0,0,10,0" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Unrealized PnL" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Futures.UnrealizedPnl, StringFormat='{}{0:N2} USDT'}"
                                       FontSize="22" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                            Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Margin Balance" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Futures.MarginBalance, StringFormat='{}{0:N2} USDT'}"
                                       FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ===== Executable Signals ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="FlashOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Active Signals" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="(Execute places a MARKET entry + Stop-Loss + TP1 bracket on Binance)"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="10,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding ExecutableSignals}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  BorderThickness="0" Background="Transparent" RowHeight="56"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Coin" Binding="{Binding Coin}" Width="*" />
                                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="*" />
                                <DataGridTextColumn Header="Entry" Binding="{Binding Entry}" Width="*" />
                                <DataGridTextColumn Header="Stop Loss" Binding="{Binding StopLoss}" Width="*" />
                                <DataGridTextColumn Header="Take Profit" Binding="{Binding TakeProfit}" Width="*" />
                                <DataGridTextColumn Header="Suggested Qty" Binding="{Binding PositionSizeDisplay}" Width="1.3*" />
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="*" />
                                <DataGridTemplateColumn Header="Action" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Explicit Height/Padding (smaller than the row) plus a plain
                                                 white TextBlock for the label - the previous version relied on
                                                 Button.Content string + a 42px-tall PrimaryButton inside a 40px
                                                 row, which clipped the text out of view entirely. -->
                                            <Button Height="34" Padding="14,0" MinWidth="80"
                                                    Margin="4"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    IsEnabled="{Binding Executed, Converter={StaticResource InverseBooleanConverter}}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding ExecuteButtonLabel}"
                                                           Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Binance-style tab strip: Positions / Open Orders / Order History / Trade History / Transaction History / Assets ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="0" Margin="0,0,0,16">
                    <TabControl Background="Transparent" BorderThickness="0" Padding="0">

                        <TabItem Header="Positions">
                            <DataGrid ItemsSource="{Binding OpenPositions}" Margin="16"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      BorderThickness="0" Background="Transparent" RowHeight="52"
                                      HeadersVisibility="Column" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding PositionAmt, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Entry Price" Binding="{Binding EntryPrice, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Break Even" Binding="{Binding BreakEvenPrice, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Mark Price" Binding="{Binding MarkPrice, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Liq. Price" Binding="{Binding LiquidationPrice, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Margin" Binding="{Binding Margin, StringFormat=N2}" Width="*" />
                                    <DataGridTextColumn Header="PNL" Binding="{Binding UnrealizedPnl, StringFormat=N2}" Width="*" />
                                    <DataGridTextColumn Header="ROI %" Binding="{Binding RoiPercent, StringFormat=N2}" Width="*" />
                                    <DataGridTextColumn Header="Leverage" Binding="{Binding Leverage, StringFormat={}{0}x}" Width="0.8*" />
                                    <DataGridTemplateColumn Header="Action" Width="0.9*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Height="34" Padding="14,0" MinWidth="76"
                                                        Margin="4"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Background="#FF5252"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.ClosePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Close" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Open Orders">
                            <DataGrid ItemsSource="{Binding OpenOrders}" Margin="16"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      BorderThickness="0" Background="Transparent" RowHeight="36"
                                      HeadersVisibility="Column" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                                    <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="*" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N6}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Order History">
                            <DataGrid ItemsSource="{Binding OrderHistory}" Margin="16"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      BorderThickness="0" Background="Transparent" RowHeight="36"
                                      HeadersVisibility="Column" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                                    <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding OrderType}" Width="*" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Avg Price" Binding="{Binding AvgPrice, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding OrigQty, StringFormat=N6}" Width="*" />
                                    <DataGridTextColumn Header="Filled" Binding="{Binding ExecutedQty, StringFormat=N6}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                    <DataGridTextColumn Header="Time" Width="1.2*">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="Time" Converter="{StaticResource UnixTimeToStringConverter}" />
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Trade History">
                            <DataGrid ItemsSource="{Binding TradeHistory}" Margin="16"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      BorderThickness="0" Background="Transparent" RowHeight="36"
                                      HeadersVisibility="Column" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                                    <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="*" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N6}" Width="*" />
                                    <DataGridTextColumn Header="Entry Price" Binding="{Binding EntryPrice, StringFormat=N4}" Width="*" />
                                    <DataGridTextColumn Header="Realized PnL" Binding="{Binding RealizedPnl, StringFormat=N2}" Width="*" />
                                    <DataGridTextColumn Header="Commission" Binding="{Binding Commission, StringFormat=N6}" Width="*" />
                                    <DataGridTextColumn Header="Time" Width="1.2*">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="Time" Converter="{StaticResource UnixTimeToStringConverter}" />
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Transaction History">
                            <DataGrid ItemsSource="{Binding IncomeHistory}" Margin="16"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      BorderThickness="0" Background="Transparent" RowHeight="36"
                                      HeadersVisibility="Column" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding IncomeType}" Width="*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Income, StringFormat=N6}" Width="*" />
                                    <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="*" />
                                    <DataGridTextColumn Header="Time" Width="1.2*">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="Time" Converter="{StaticResource UnixTimeToStringConverter}" />
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Assets">
                            <DataGrid ItemsSource="{Binding Balances}" Margin="16"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      BorderThickness="0" Background="Transparent" RowHeight="36"
                                      HeadersVisibility="Column" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="*" />
                                    <DataGridTextColumn Header="Available" Binding="{Binding Free, StringFormat=N8}" Width="*" />
                                    <DataGridTextColumn Header="Locked" Binding="{Binding Locked, StringFormat=N8}" Width="*" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N8}" Width="*" />
                                    <DataGridTextColumn Header="Value (USDT)" Binding="{Binding ValueUsdt, StringFormat=N2}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Trading Logs">
                            <!-- Backed by GET /trading/logs (in-memory ring buffer over the
                                 same Loguru output already written to stdout/logs/*.log - see
                                 app/core/log_buffer.py). Polled every 5s while this screen is open. -->
                            <DataGrid ItemsSource="{Binding LogEntries}" Margin="16"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      BorderThickness="0" Background="Transparent" RowHeight="28"
                                      HeadersVisibility="Column" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="1.4*" />
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="0.7*" />
                                    <DataGridTextColumn Header="Logger" Binding="{Binding Logger}" Width="1.4*" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                    </TabControl>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
