<!-- ========== Views/SettingsView.xaml ========== -->
<UserControl x:Class="AI_Crypto_Signal_Pro.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
             TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Configure exchange access, notifications and trading preferences"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <!-- ===== Binance API Credentials ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="ShieldAccountOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Binance API Credentials" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12">
                            <Run Text="Status:" />
                            <Run Text="{Binding HasSavedCredentials, Mode=OneWay, StringFormat='{}{0}'}" FontWeight="SemiBold" />
                            <Run Text=" (" /><Run Text="{Binding SavedCredentialsEnvironment}" FontWeight="SemiBold" /><Run Text=")" />
                        </TextBlock>

                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="API Key"
                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" />

                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Secret Key"
                                 Text="{Binding SecretKey, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding Testnet}" />
                            <TextBlock Text="Use Testnet (instead of live Mainnet)" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Telegram Notifications ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="MessageTextOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Telegram Notifications" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Bot Token"
                                 Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" />

                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Chat ID"
                                 Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding EnableNotifications}" />
                            <TextBlock Text="Enable Notifications" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Trading Preferences ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="ChartLineVariant" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Trading Preferences" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding AutoTrading}" />
                            <TextBlock Text="Enable Auto Trading" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="13" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Risk per trade (%)"
                                     Text="{Binding RiskPercent, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Column="2"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Leverage"
                                     Text="{Binding Leverage, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Appearance ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="PaletteOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Theme"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}" />

                            <ComboBox Grid.Column="2"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Language"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Actions ===== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Button Content="Save Settings"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                    <Button Content="Reset to Defaults"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding ResetCommand}"
                            Margin="12,0,0,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="16,0,0,0" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
