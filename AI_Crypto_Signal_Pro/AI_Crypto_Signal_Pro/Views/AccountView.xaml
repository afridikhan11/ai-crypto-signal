<!-- ========== Views/AccountView.xaml ==========
     Read-only Binance account viewer. No controls here ever place, amend,
     or cancel an order - this screen only displays data returned by the
     backend's read-only /api/v1/account/* endpoints. -->
<UserControl x:Class="AI_Crypto_Signal_Pro.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
             TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Binance Account" FontSize="22" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0">
                    <Run Text="Read-only view of your Binance account." />
                    <Run Text=" Environment: " />
                    <Run Text="{Binding Environment}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                           Foreground="#FF5252" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding IsAutoRefreshEnabled}"
                              VerticalAlignment="Center"
                              ToolTip="Auto-refresh every 10 seconds" />
                <TextBlock Text="Auto Refresh" VerticalAlignment="Center"
                           Margin="8,0,16,0" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <Button Content="Test Connection"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding TestConnectionCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Refresh"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===== Warnings ===== -->
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="#332B1F" Padding="12,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding}" Foreground="#FFB74D" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Account Info ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="ShieldAccountOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Account" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <UniformGrid Columns="5">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Account Type" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Account.AccountType}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Status" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Account.AccountStatus}" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Can Trade" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Account.CanTrade}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Can Withdraw" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Account.CanWithdraw}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Can Deposit" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Account.CanDeposit}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Balances ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseOutline" Width="18" Height="18"
                                                         Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Balances" FontSize="15" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Total Wallet Value: " FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalWalletValueUsdt, StringFormat='{}{0:N2} USDT'}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding Balances}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  BorderThickness="0" Background="Transparent" RowHeight="36"
                                  HeadersVisibility="Column" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="*" />
                                <DataGridTextColumn Header="Available" Binding="{Binding Free, StringFormat=N8}" Width="*" />
                                <DataGridTextColumn Header="Locked" Binding="{Binding Locked, StringFormat=N8}" Width="*" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N8}" Width="*" />
                                <DataGridTextColumn Header="Value (USDT)" Binding="{Binding ValueUsdt, StringFormat=N2}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Futures ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="ChartLineVariant" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Futures" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Wallet Balance" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Futures.WalletBalance, StringFormat=N2}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Available Balance" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Futures.AvailableBalance, StringFormat=N2}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Unrealized PnL" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Futures.UnrealizedPnl, StringFormat=N2}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Margin Balance" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Futures.MarginBalance, StringFormat=N2}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Open Positions" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding OpenPositions}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  BorderThickness="0" Background="Transparent" RowHeight="36"
                                  HeadersVisibility="Column" MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding PositionAmt, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="Entry Price" Binding="{Binding EntryPrice, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="Break Even" Binding="{Binding BreakEvenPrice, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="Mark Price" Binding="{Binding MarkPrice, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="Liq. Price" Binding="{Binding LiquidationPrice, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="Margin" Binding="{Binding Margin, StringFormat=N2}" Width="*" />
                                <DataGridTextColumn Header="PNL" Binding="{Binding UnrealizedPnl, StringFormat=N2}" Width="*" />
                                <DataGridTextColumn Header="ROI %" Binding="{Binding RoiPercent, StringFormat=N2}" Width="*" />
                                <DataGridTextColumn Header="Leverage" Binding="{Binding Leverage, StringFormat={}{0}x}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Trade History ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Trade History" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="(symbols auto-detected from open orders, positions and balances)"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="10,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding TradeHistory}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  BorderThickness="0" Background="Transparent" RowHeight="36"
                                  HeadersVisibility="Column" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N6}" Width="*" />
                                <DataGridTextColumn Header="Entry Price" Binding="{Binding EntryPrice, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="Exit Price" Binding="{Binding ExitPrice, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="Realized PnL" Binding="{Binding RealizedPnl, StringFormat=N2}" Width="*" />
                                <DataGridTextColumn Header="Commission" Binding="{Binding Commission, StringFormat=N6}" Width="*" />
                                <DataGridTextColumn Header="Time" Width="*">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Time" Converter="{StaticResource UnixTimeToStringConverter}" />
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Open Orders ===== -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="ClipboardListOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Open Orders" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding OpenOrders}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  BorderThickness="0" Background="Transparent" RowHeight="36"
                                  HeadersVisibility="Column" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="*" />
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N6}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
