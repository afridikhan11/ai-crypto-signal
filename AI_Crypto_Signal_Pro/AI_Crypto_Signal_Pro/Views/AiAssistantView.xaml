<!-- ========== Views/AiAssistantView.xaml ==========
     Single conversational front end over POST /agent/query - unifies the AI Trading
     Agent, Evidence & Reasoning Engine, Research & Market Intelligence Engine, and AI
     Trading Coach (Phases 2, 4, 5, 6) into one screen, since the backend already
     composes all four into a single AgentQueryResponse. Every value shown here comes
     directly from that response - this screen never computes a score or decision
     itself, and never shows a section the backend didn't actually return. -->
<UserControl x:Class="AI_Crypto_Signal_Pro.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
             TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="AI Assistant" FontSize="22" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"
                           TextWrapping="Wrap">
                    Ask about any coin, contract, or trading question ("Analyze BTCUSDT", "Should I take
                    partial profit on ETH?", "Compare SOL and AVAX"). Every answer is reasoned only from
                    this platform's existing Decision Engine, Evidence Engine, and Research Engine - never
                    a new market analysis, never a substitute for the Decision Engine's own verdict.
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                           Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
            </StackPanel>

            <Button Grid.Column="1" Content="Clear Session"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding ClearSessionCommand}"
                    VerticalAlignment="Top"
                    ToolTip="Forgets the last analyzed asset and turn history for this conversation." />
        </Grid>

        <!-- Conversation -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ConversationScroll">
            <ItemsControl ItemsSource="{Binding Conversation}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Padding="16" Margin="0,0,0,12" MaxWidth="820">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <!-- Narrative / user text -->
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />

                                <!-- ===== Decision summary (single-asset) ===== -->
                                <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}"
                                        Padding="14" Margin="0,12,0,0"
                                        Visibility="{Binding Response.Decision, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Response.Decision.SymbolOrAddress}" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="{Binding Response.Decision.FinalDecision}"
                                                       FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="Confidence " /><Run Text="{Binding Response.Decision.ConfidencePct}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /><Run Text="%  ·  Trend " />
                                            <Run Text="{Binding Response.Decision.Trend}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /><Run Text="  ·  R:R " />
                                            <Run Text="{Binding Response.Decision.RiskReward}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="Entry " /><Run Text="{Binding Response.Decision.Entry, StringFormat=N4}" Foreground="{DynamicResource PrimaryTextBrush}" /><Run Text="  ·  SL " />
                                            <Run Text="{Binding Response.Decision.StopLoss, StringFormat=N4}" Foreground="{DynamicResource PrimaryTextBrush}" /><Run Text="  ·  TP " />
                                            <Run Text="{Binding Response.Decision.TakeProfit1, StringFormat=N4}" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Response.Decision.Reasons}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='+ {0}'}" FontSize="11"
                                                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Response.Decision.Warnings}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='! {0}'}" FontSize="11"
                                                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Comparison (multi-asset) ===== -->
                                <ItemsControl ItemsSource="{Binding Response.Comparison}" Margin="0,12,0,0"
                                              Visibility="{Binding Response.Comparison, Converter={StaticResource NullToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}"
                                                    Padding="12" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SymbolOrAddress}" FontWeight="Bold" FontSize="12" Width="100" />
                                                    <TextBlock Text="{Binding FinalDecision}" FontSize="12" Width="90"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Confidence " /><Run Text="{Binding ConfidencePct}" /><Run Text="%" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ===== Ranked scan results ===== -->
                                <ItemsControl ItemsSource="{Binding Response.Ranked}" Margin="0,12,0,0"
                                              Visibility="{Binding Response.Ranked, Converter={StaticResource NullToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}"
                                                    Padding="12" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Symbol}" FontWeight="Bold" FontSize="12" Width="100" />
                                                    <TextBlock Text="{Binding Direction}" FontSize="12" Width="70" />
                                                    <TextBlock FontSize="12">
                                                        <Run Text="Confidence " /><Run Text="{Binding Confidence}" /><Run Text="%  ·  R:R " /><Run Text="{Binding RiskReward}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ===== AI Trading Coach advice ===== -->
                                <Border CornerRadius="8" Background="#14263B" Padding="14" Margin="0,12,0,0"
                                        Visibility="{Binding Response.CoachAdvice, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16" Foreground="{DynamicResource InfoBrush}" />
                                            <TextBlock Text="{Binding Response.CoachAdvice.QuestionLabel}" FontWeight="SemiBold" FontSize="13"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource InfoBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Response.CoachAdvice.Verdict}" FontSize="14" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Response.CoachAdvice.Reasoning}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='- {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Response.CoachAdvice.CautionFlags}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Response.CoachAdvice.Disclaimer}" FontSize="10" FontStyle="Italic"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- ===== Evidence ===== -->
                                <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Padding="14" Margin="0,12,0,0"
                                        Visibility="{Binding Response.Evidence, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MagnifyScan" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="Evidence" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Response.Evidence.PositiveFactors}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0">
                                                        <Run Text="+ " /><Run Text="{Binding Label}" FontWeight="SemiBold" /><Run Text=" - " /><Run Text="{Binding Detail}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Response.Evidence.NegativeFactors}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0">
                                                        <Run Text="- " /><Run Text="{Binding Label}" FontWeight="SemiBold" /><Run Text=" - " /><Run Text="{Binding Detail}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Response.Evidence.ConfidenceExplanation.Summary}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Visibility="{Binding Response.Evidence.ConfidenceExplanation, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <ItemsControl ItemsSource="{Binding Response.Evidence.DataGaps}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='Data gap: {0}'}" FontSize="11" FontStyle="Italic"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Research & Market Intelligence ===== -->
                                <Border CornerRadius="8" Background="{DynamicResource ElevatedBackgroundBrush}" Padding="14" Margin="0,12,0,0"
                                        Visibility="{Binding Response.Research, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="Market Intelligence (supporting context, not a signal)" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Response.Research.Summary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <ItemsControl ItemsSource="{Binding Response.Research.Signals}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <Run Text="{Binding Label}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Value}" /><Run Text=" - " />
                                                        <Run Text="{Binding Interpretation}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Response.Research.Disclaimer}" FontSize="10" FontStyle="Italic"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- ===== Response-level warnings / context note ===== -->
                                <ItemsControl ItemsSource="{Binding Response.Warnings}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='! {0}'}" FontSize="11"
                                                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Response.ContextNote}" FontSize="11" FontStyle="Italic" Margin="0,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding Response.ContextNote, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input row -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     materialDesign:HintAssist.Hint="Ask about a coin, contract, or trading question..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1" Content="Send" Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />
        </Grid>
    </Grid>
</UserControl>
