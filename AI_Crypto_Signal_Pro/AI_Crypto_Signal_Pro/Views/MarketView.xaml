<!-- ========== Views/MarketView.xaml ========== -->
<UserControl x:Class="AI_Crypto_Signal_Pro.Views.MarketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
             TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Market Overview" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Live market insights and top movers" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Height="240" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Top Gainers" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding TopGainers}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"
                                  Background="Transparent" RowHeight="36" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Coin" Binding="{Binding Coin}" Width="*" />
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="24h Change" Binding="{Binding Change24h, StringFormat={}{0:+0.00;-0.00;0.00}%}" Width="*"
                                                    Foreground="{DynamicResource SuccessBrush}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Top Losers" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding TopLosers}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"
                                  Background="Transparent" RowHeight="36" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Coin" Binding="{Binding Coin}" Width="*" />
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N4}" Width="*" />
                                <DataGridTextColumn Header="24h Change" Binding="{Binding Change24h, StringFormat={}{0:0.00}%}" Width="*"
                                                    Foreground="{DynamicResource DangerBrush}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Height="100" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BTC Dominance" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                        <TextBlock Text="48.2%" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Fear &amp; Greed" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                        <TextBlock Text="65" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,10,0" Padding="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="24h Volume" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                        <TextBlock Text="$4.2B" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Padding="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Market Cap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                        <TextBlock Text="$1.3T" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" Padding="16" Height="200">
                <StackPanel>
                    <TextBlock Text="Trending Coins" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding TrendingCoins}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"
                              Background="Transparent" RowHeight="36" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Coin" Binding="{Binding Coin}" Width="*" />
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N4}" Width="*" />
                            <DataGridTextColumn Header="Change" Binding="{Binding Change24h, StringFormat={}{0:0.00}%}" Width="*" />
                            <DataGridTextColumn Header="Volume" Binding="{Binding Volume, StringFormat=N2}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>




