<!-- DashboardView.xaml -->
<UserControl x:Class="AI_Crypto_Signal_Pro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
             TextElement.FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <DataTemplate x:Key="PanelRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Value}"
                           Foreground="{Binding ValueColor}"
                           FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="160" TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Account Panel -->
            <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                    Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Wallet" Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Live account" FontWeight="SemiBold" FontSize="14"
                                   Margin="8,0,0,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AccountRows}"
                                  ItemTemplate="{StaticResource PanelRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- AI Panel -->
            <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                    Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Brain" Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="AI scorer" FontWeight="SemiBold" FontSize="14"
                                   Margin="8,0,0,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AiRows}"
                                  ItemTemplate="{StaticResource PanelRowTemplate}" />

                    <TextBlock Text="Category weights" FontWeight="SemiBold" FontSize="12"
                               Margin="0,12,0,6" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding AiWeightRows}"
                                  ItemTemplate="{StaticResource PanelRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- Market Panel -->
            <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                    Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="ChartLineVariant" Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Market context (BTC)" FontWeight="SemiBold" FontSize="14"
                                   Margin="8,0,0,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding MarketRows}"
                                  ItemTemplate="{StaticResource PanelRowTemplate}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
