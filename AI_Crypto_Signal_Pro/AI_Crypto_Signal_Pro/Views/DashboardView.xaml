<!-- DashboardView.xaml -->
<UserControl x:Class="AI_Crypto_Signal_Pro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
             >
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <!-- Statistic Cards -->
            <Grid Height="120" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Total Signals -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Margin="0,0,10,0" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Signals" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                        <TextBlock Text="1,283" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="+12% this month" Foreground="{DynamicResource SuccessBrush}" FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <!-- Win Rate -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Margin="0,0,10,0" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Win Rate" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                        <TextBlock Text="78.5%" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Last 30 days" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <!-- Active Trades -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                        Margin="0,0,10,0" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Active Trades" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                        <TextBlock Text="9" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Open positions" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <!-- AI Confidence -->
                <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" Padding="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI Confidence" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                        <TextBlock Text="92" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Avg score" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Market Overview Panel -->
            <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                    Padding="16" Height="200" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Market Overview" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />
                    <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                            CornerRadius="6" Height="140">
                        <TextBlock Text="Chart Area" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Recent Signals Table -->
            <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                    Padding="16" Height="280" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Recent Signals" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />
                    <DataGrid AutoGenerateColumns="False" BorderThickness="0" Background="Transparent"
                              IsReadOnly="True" RowHeight="36" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Coin" Binding="{Binding Coin}" Width="*" />
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="*" />
                            <DataGridTextColumn Header="Entry" Binding="{Binding Entry}" Width="*" />
                            <DataGridTextColumn Header="SL" Binding="{Binding StopLoss}" Width="*" />
                            <DataGridTextColumn Header="TP1" Binding="{Binding TakeProfit}" Width="*" />
                            <DataGridTextColumn Header="Conf" Binding="{Binding Confidence}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Fear &amp; Greed Widget Placeholder -->
            <Border CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                    Padding="16" Height="150">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="EmoticonOutline" Width="32" Height="32"
                                             Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Fear &amp; Greed Index" Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="Coming Soon" Foreground="{DynamicResource DisabledTextBrush}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>




