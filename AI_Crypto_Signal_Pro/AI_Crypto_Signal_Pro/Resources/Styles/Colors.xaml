<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!-- Core Backgrounds          -->
    <!-- ========================= -->

    <Color x:Key="PrimaryBackgroundColor">#0D1117</Color>
    <Color x:Key="SecondaryBackgroundColor">#161B22</Color>
    <Color x:Key="CardBackgroundColor">#1C2128</Color>
    <Color x:Key="ElevatedBackgroundColor">#21262D</Color>

    <SolidColorBrush x:Key="PrimaryBackgroundBrush"
                     Color="{StaticResource PrimaryBackgroundColor}" />

    <SolidColorBrush x:Key="SecondaryBackgroundBrush"
                     Color="{StaticResource SecondaryBackgroundColor}" />

    <SolidColorBrush x:Key="CardBackgroundBrush"
                     Color="{StaticResource CardBackgroundColor}" />

    <SolidColorBrush x:Key="ElevatedBackgroundBrush"
                     Color="{StaticResource ElevatedBackgroundColor}" />


    <!-- ========================= -->
    <!-- Accent                    -->
    <!-- ========================= -->

    <Color x:Key="AccentColor">#00E676</Color>
    <Color x:Key="AccentHoverColor">#00C853</Color>

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="{StaticResource AccentHoverColor}" />


    <!-- ========================= -->
    <!-- Status                    -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="SuccessBrush" Color="#00E676"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5252"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC107"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#29B6F6"/>


    <!-- ========================= -->
    <!-- Text                      -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="PrimaryTextBrush"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SecondaryTextBrush"
                     Color="#A0AEC0"/>

    <SolidColorBrush x:Key="DisabledTextBrush"
                     Color="#5A5F66"/>


    <!-- ========================= -->
    <!-- Borders                   -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="CardBorderBrush"
                     Color="#30363D"/>

    <SolidColorBrush x:Key="DividerLineBrush"
                     Color="#2B3138"/>


    <!-- ========================= -->
    <!-- Glassmorphism             -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="GlassBackgroundBrush"
                     Color="#12FFFFFF"/>

    <SolidColorBrush x:Key="GlassBorderBrush"
                     Color="#25FFFFFF"/>


    <!-- ========================= -->
    <!-- Shadows                   -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="ShadowBrush"
                     Color="#99000000"/>

    <SolidColorBrush x:Key="HighlightBrush"
                     Color="#10FFFFFF"/>

</ResourceDictionary>